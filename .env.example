# ForgeLLM Environment Configuration Example
# Copy to .env for local development or Modal/Vercel deployment

# Environment & Security
FORGELLM_ENV=development
ENVIRONMENT=development
FORGE_API_KEY=forge-secret-key-2026-prod

# Model & Inference Settings
FORGELLM_INFERENCE_MODE=real
INFERENCE_MODE=real
FORGELLM_TRAINING_MODE=real
TRAINING_MODE=real

# Base Model Selection
FORGELLM_BASE_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
DEFAULT_BASE_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct

# Device Selection: 'auto' (CUDA > MPS > CPU), 'cuda', 'mps', or 'cpu'
FORGELLM_DEVICE=auto
DEVICE=auto

# Frontend API URL Configuration (Vite)
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# CORS Allowed Origins (Comma-Separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Rate Limiting & Storage
RATE_LIMIT_PER_MINUTE=60
DATABASE_URL=sqlite:///./storage/feedback.db
